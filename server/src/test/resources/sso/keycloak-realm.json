{
  "realm": "buggywuggy",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "verifyEmail": false,
  "groups": [
    { "name": "staff" },
    { "name": "buggywuggy-admins" }
  ],
  "clients": [
    {
      "clientId": "buggywuggy",
      "name": "BuggyWuggy",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "test-secret",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["*"],
      "webOrigins": ["+"],
      "attributes": {
        "post.logout.redirect.uris": "+",
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "full.path": "false",
            "claim.name": "groups",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "alice",
      "enabled": true,
      "email": "alice@example.org",
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Adams",
      "credentials": [{ "type": "password", "value": "alice-password", "temporary": false }],
      "groups": ["/staff", "/buggywuggy-admins"]
    },
    {
      "username": "bob",
      "enabled": true,
      "email": "bob@example.org",
      "emailVerified": true,
      "firstName": "Bob",
      "lastName": "Brown",
      "credentials": [{ "type": "password", "value": "bob-password", "temporary": false }],
      "groups": ["/staff"]
    },
    {
      "username": "carol",
      "enabled": true,
      "email": "carol@example.org",
      "emailVerified": false,
      "firstName": "Carol",
      "lastName": "Clark",
      "credentials": [{ "type": "password", "value": "carol-password", "temporary": false }]
    },
    {
      "username": "dave",
      "enabled": true,
      "email": "dave@example.org",
      "emailVerified": true,
      "firstName": "Dave",
      "lastName": "Davis",
      "credentials": [{ "type": "password", "value": "dave-password", "temporary": false }]
    }
  ]
}
