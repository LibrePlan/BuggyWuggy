<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.2</version>
        <relativePath/>
    </parent>

    <groupId>org.buggywuggy</groupId>
    <artifactId>buggywuggy-parent</artifactId>
    <version>0.3.3</version>
    <packaging>pom</packaging>

    <name>BuggyWuggy</name>
    <description>Open source, self-hosted issue tracker</description>

    <licenses>
        <license>
            <name>GNU Affero General Public License v3.0 or later</name>
            <url>https://www.gnu.org/licenses/agpl-3.0.html</url>
        </license>
    </licenses>

    <modules>
        <module>web</module>
        <module>server</module>
    </modules>

    <properties>
        <java.version>25</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <bouncycastle.version>1.87</bouncycastle.version>
        <springdoc.version>3.2.0</springdoc.version>
        <zxing.version>3.5.3</zxing.version>
        <jsoup.version>1.23.2</jsoup.version>
        <commonmark.version>0.32.0</commonmark.version>
        <!-- Demo mode, chosen at build time: ./mvnw -Ddemo package (see server/pom.xml). -->
        <buggywuggy.demo>false</buggywuggy.demo>
        <greenmail.version>2.1.15</greenmail.version>
        <!-- Only the server module is an application; see server/pom.xml. -->
        <spring-boot.run.skip>true</spring-boot.run.skip>
    </properties>
</project>
