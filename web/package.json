{
  "name": "buggywuggy-web",
  "private": true,
  "version": "1.4.9",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "sbom": "cyclonedx-npm --omit dev --output-reproducible --validate --output-file target/classes/META-INF/sbom/web.cdx.json",
    "api:types": "npx --yes -p typescript@5.9.3 -p openapi-typescript@7.13.0 openapi-typescript ${BUGGYWUGGY_API_URL:-http://localhost:8080}/api/openapi -o src/api/schema.d.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@mantine/core": "9.8.0",
    "@mantine/form": "9.8.0",
    "@mantine/hooks": "9.8.0",
    "@mantine/notifications": "9.8.0",
    "@tabler/icons-react": "3.51.0",
    "@tanstack/react-query": "5.107.1",
    "i18next": "27.1.1",
    "markdown-it": "14.3.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "18.0.1",
    "react-router": "8.5.1"
  },
  "devDependencies": {
    "@cyclonedx/cyclonedx-npm": "6.0.1",
    "@types/markdown-it": "14.1.2",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
