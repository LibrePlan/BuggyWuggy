# Settings of the BuggyWuggy service, read by buggywuggy.service (EnvironmentFile).
# Install as /etc/buggywuggy/buggywuggy.env, owner root, mode 600: it contains the database
# password.
# One VARIABLE=value per line, no "export", no spaces around "=". After a change:
#   systemctl restart buggywuggy
# All settings and their defaults: "Configuration" in docs/installation.md.

# The database (see "Preparing the database").
BUGGYWUGGY_DB_URL=jdbc:postgresql://localhost:5432/buggywuggy
BUGGYWUGGY_DB_USER=buggywuggy
BUGGYWUGGY_DB_PASSWORD=choose-a-strong-password

# The port BuggyWuggy listens on. Behind a reverse proxy, let only the proxy reach it.
BUGGYWUGGY_PORT=8080

# The address users open BuggyWuggy at; used in mails and links.
BUGGYWUGGY_BASE_URL=https://bugs.example.org

# Attachments. The service may only write here (ReadWritePaths in buggywuggy.service).
BUGGYWUGGY_DATA_DIR=/var/lib/buggywuggy
#BUGGYWUGGY_MAX_ATTACHMENT_SIZE=50MB
#BUGGYWUGGY_MAX_UPLOAD_SIZE=200MB

# Behind a reverse proxy with HTTPS (docs/reverse-proxy): cookies only over HTTPS, and trust
# the X-Forwarded-* headers of the proxy. Only when BuggyWuggy can be reached through the
# proxy alone; without a proxy set both to false and remove the second one.
BUGGYWUGGY_SECURE_COOKIES=true
SERVER_FORWARD_HEADERS_STRATEGY=framework

# How long an idle login stays valid.
#BUGGYWUGGY_SESSION_TIMEOUT=8h

# A fixed token for the first-time setup instead of a random one in the log.
#BUGGYWUGGY_SETUP_TOKEN=

# Mail and the other settings: in this configuration file (made with "config-template", see
# buggywuggy.service). "optional:" lets BuggyWuggy start when the file does not exist.
SPRING_CONFIG_ADDITIONAL_LOCATION=optional:file:/etc/buggywuggy/application.yml
# The service cannot write the template itself (the file system is read-only for it).
BUGGYWUGGY_CONFIG_GENERATE=false
