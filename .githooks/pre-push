#
# Guards pushes to chosen remotes. Does nothing until configured (per clone, with git config):
#
#   bwflow.protect    remotes that get no push at all, e.g. the official repository
#                     (override once: BW_ALLOW_PUSH=1 git push ...)
#   bwflow.requireCi  remotes that only get commits whose CI succeeded, e.g. your fork
#   bwflow.ciCheck    command that checks one commit: called with the commit id, exit 0 = CI
#                     succeeded for exactly that commit
#
# Several remotes: separate them with spaces. Install the hooks once per clone:
#   git config core.hooksPath .githooks
set -euo pipefail

remote=$1
protect=" $(git config --get bwflow.protect || true) "
require_ci=" $(git config --get bwflow.requireCi || true) "
check=$(git config --get bwflow.ciCheck || true)
zero=0000000000000000000000000000000000000000

if [[ $protect == *" $remote "* && ${BW_ALLOW_PUSH:-} != 1 ]]; then
    echo "pre-push: no pushes to '$remote' (git config bwflow.protect)." >&2
    echo "  Changes go there through a pull request. Really needed: BW_ALLOW_PUSH=1 git push ..." >&2
    exit 1
fi

[[ $require_ci == *" $remote "* ]] || exit 0
if [[ -z $check ]]; then
    echo "pre-push: '$remote' requires CI, but git config bwflow.ciCheck is not set." >&2
    exit 1
fi

status=0
while read -r local_ref local_sha _remote_ref _remote_sha; do
    [[ $local_sha == "$zero" ]] && continue # deleting a branch
    # An annotated tag arrives as the id of the tag object: CI ran for the commit it points to.
    commit=$(git rev-parse --verify --quiet "$local_sha^{commit}" || echo "$local_sha")
    if ! $check "$commit" >&2; then
        echo "pre-push: CI has not succeeded for ${commit:0:10} ($local_ref); not pushed to '$remote'." >&2
        status=1
    fi
done
exit $status
